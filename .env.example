# Required: token written to ${XDG_CONFIG_HOME:-$HOME/.config}/obsidian-headless/auth_token at startup if missing.
OBSIDIAN_AUTH_TOKEN=replace-me-with-real-token

# Required: JSON array of vaults. slug defaults to kebab-case(name); e2eePassword optional.
VAULTS_JSON=[{"name":"my-vault","slug":"my-vault"}]

# Optional: filesystem root for vaults, LanceDB store, model cache. Default /data.
DATA_DIR=/data

# Optional: HTTP listener.
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# Optional: embeddings.
EMBEDDING_PROVIDER=transformers
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Required only when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: log level (trace|debug|info|warn|error). Default info.
LOG_LEVEL=info
