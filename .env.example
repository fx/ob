# Required: token written to ${XDG_CONFIG_HOME:-$HOME/.config}/obsidian-headless/auth_token at startup if missing.
OBSIDIAN_AUTH_TOKEN=replace-me-with-real-token

# Required: JSON array of vaults. slug defaults to kebab-case(name); e2eePassword optional.
VAULTS_JSON=[{"name":"my-vault","slug":"my-vault"}]

# Optional: filesystem root for vaults, LanceDB store, model cache. Default /data.
DATA_DIR=/data

# Optional: HTTP listener.
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# Optional: embeddings.
EMBEDDING_PROVIDER=transformers
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Required only when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: log level (trace|debug|info|warn|error). Default info.
LOG_LEVEL=info

# Optional: `ob sync-config` bootstrap. Each var is OPTIONAL. Unset = preserve
# the on-disk value. Empty string = forward verbatim as the upstream
# "empty to clear" sentinel. If every OB_SYNC_* var is unset, `ob sync-config`
# is skipped entirely. Invalid enum values cause exit 78 before any vault is
# touched.
#
# Comma-separated subset of: image,audio,pdf,video,unsupported
# OB_SYNC_FILE_TYPES=
# Passed verbatim to --excluded-folders.
# OB_SYNC_EXCLUDED_FOLDERS=
# One of: bidirectional, pull-only, mirror-remote
# OB_SYNC_MODE=
# One of: merge, conflict
# OB_SYNC_CONFLICT_STRATEGY=
# Passed verbatim to --device-name.
# OB_SYNC_DEVICE_NAME=
# Comma-separated subset of: app,appearance,appearance-data,hotkey,
#   core-plugin,core-plugin-data,community-plugin,community-plugin-data
# OB_SYNC_CONFIGS=
